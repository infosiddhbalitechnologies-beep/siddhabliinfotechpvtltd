# Same values as your website's .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SUPABASE_URL=
# Service role key (server-side only — never ship this to a browser)
SUPABASE_SERVICE_ROLE_KEY=
# Publishable/anon key (same one your website's .env calls
# SUPABASE_PUBLISHABLE_KEY). Required for ticket creation and for the bot
# to recognize logged-in visitors — without it, everyone is treated as a
# guest and ticket creation always returns "login required".
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
# Use "*" only for local testing.
CORS_ORIGINS=https://sidddhbali.tech,http://localhost:5173
